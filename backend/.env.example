# =============================================================
# SOB CONTROLE — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env real no repositório!
# =============================================================

# ─── Database (SQLite - desenvolvimento local) ────────────────
DB_PATH=database/tcc_financeira.db

# ─── Security ────────────────────────────────────────────────
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE_DE_64_CARACTERES_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Application ─────────────────────────────────────────────
APP_NAME=Sob Controle
APP_VERSION=1.0.0
# Em produção, mude para False!
DEBUG=True

# ─── CORS (separar por vírgula se múltiplos) ──────────────────
# Em produção, coloque apenas a URL do seu frontend na Vercel:
# ALLOWED_ORIGINS=https://seu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ─── AI Copilot ──────────────────────────────────────────────
# Google Gemini (fallback): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (principal - gratuito e rápido): https://console.groq.com/keys
GROQ_API_KEY=

# ─── Telegram Bot ────────────────────────────────────────────
# Crie seu bot em @BotFather no Telegram e cole o token abaixo
# Documentação: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=

# ─── Email (opcional - para notificações futuras) ─────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASSWORD=sua_senha_de_app
# EMAIL_FROM=noreply@sobcontrole.com
